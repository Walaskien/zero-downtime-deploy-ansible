# Managed by Ansible. Draining instances are left out of the upstream on purpose:
# nginx resolves upstream names when it loads the config, and a stopped container has no name to resolve.
upstream app {
{% for name in lb_members %}
    server zdd-{{ name }}:8000 max_fails=0;
{% endfor %}
}

server {
    listen 80;
    location / {
        proxy_pass http://app;
        proxy_connect_timeout 1s;
        proxy_next_upstream error timeout http_502 http_503;
    }
}
