# Rendered by Ansible
# Only running instances are listed: nginx resolves the names when it loads
# the config, and a name without a container fails the reload.
#
# max_fails=0, otherwise one refused connection takes a server out for 10s
upstream app {
{% for name in lb_pool %}
    server zdd-{{ name }}:8000 max_fails=0;
{% endfor %}
}

# A comma in the upstream address means nginx had to retry on another instance
log_format upstreams '$status $upstream_addr';

server {
    listen 80;
    access_log /dev/stdout upstreams;

    location / {
        proxy_pass http://app;
        proxy_connect_timeout 1s;
        proxy_next_upstream error timeout http_502 http_503;
    }
}
